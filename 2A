-- Q3
SELECT Users.name, COUNT(Workouts.workout_ID) AS Total_Workouts
FROM Users
LEFT JOIN Workouts ON Users.user_ID = Workouts.user_ID
GROUP BY Users.user_ID, Users.name;

-- Q4
CREATE VIEW Workout_Summary AS
SELECT Users.name, Workouts.workout_type,
SUM(Workouts.duration_in_minutes) AS Total_Duration
FROM Users
JOIN Workouts ON Users.user_ID = Workouts.user_ID
GROUP BY Users.user_ID, Users.name, Workouts.workout_type;

SELECT * FROM Workout_Summary;

