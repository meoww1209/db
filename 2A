DELIMITER //

CREATE TRIGGER Check_Workout_Time
BEFORE INSERT ON Workouts
FOR EACH ROW
BEGIN
    IF NEW.end_time < NEW.start_time THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'End time cannot be earlier than start time';
    END IF;
END //

DELIMITER ;

