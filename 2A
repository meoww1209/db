DELIMITER //

CREATE PROCEDURE GetWorkouts(
    IN uid INT,
    IN start_date DATE,
    IN end_date DATE
)
BEGIN
    SELECT *
    FROM Workouts
    WHERE user_ID = uid
    AND workout_date BETWEEN start_date AND end_date;
END //

DELIMITER ;

