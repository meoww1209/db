CREATE DATABASE FitnessDB_2A;
USE FitnessDB_2A;

CREATE TABLE Goals (
    goal_ID INT PRIMARY KEY,
    goal_type VARCHAR(50)
);

CREATE TABLE Users (
    user_ID INT PRIMARY KEY,
    name VARCHAR(50),
    email VARCHAR(100),
    registration_date DATE,
    goal_ID INT
);

CREATE TABLE Users_Goal (
    user_ID INT,
    goal_ID INT,
    goal_type VARCHAR(50)
);

CREATE TABLE Workouts (
    workout_ID INT PRIMARY KEY,
    user_ID INT,
    date DATE,
    workout_type VARCHAR(50),
    start_time TIME,
    end_time TIME,
    duration_in_minutes INT
);

CREATE TABLE WorkoutDetails (
    workout_ID INT,
    exercise_name VARCHAR(50),
    sets INT,
    repetitions INT,
    weight FLOAT
);

CREATE TABLE Steps (
    step_ID INT PRIMARY KEY,
    user_ID INT,
    tracking_date DATE,
    step_count INT
);

-- Q1. Total workout duration per user on a particular day

SELECT Users.user_ID, Users.name,
SUM(Workouts.duration_in_minutes) AS Total_Duration
FROM Users
JOIN Workouts ON Users.user_ID = Workouts.user_ID
WHERE Workouts.date = '2026-11-05'
GROUP BY Users.user_ID, Users.name;

-- Q2. Procedure to retrieve workouts within a date range

DELIMITER //

CREATE PROCEDURE Get_Workouts(
    IN uid INT,
    IN start_date DATE,
    IN end_date DATE
)
BEGIN
    SELECT *
    FROM Workouts
    WHERE user_ID = uid
    AND date BETWEEN start_date AND end_date;
END //

DELIMITER ;

CALL Get_Workouts(1, '2026-11-01', '2026-11-30');

-- Q3. Users with total number of workouts

SELECT Users.name,
COUNT(Workouts.workout_ID) AS Total_Workouts
FROM Users
LEFT JOIN Workouts ON Users.user_ID = Workouts.user_ID
GROUP BY Users.user_ID, Users.name;

-- Q4. View for workout summary

CREATE VIEW Workout_Summary AS
SELECT Users.name, Workouts.workout_type,
SUM(Workouts.duration_in_minutes) AS Total_Duration
FROM Users
JOIN Workouts ON Users.user_ID = Workouts.user_ID
GROUP BY Users.user_ID, Users.name, Workouts.workout_type;

SELECT * FROM Workout_Summary;

-- Q5. Users whose goal is to lose weight

SELECT Users.name
FROM Users
JOIN Goals ON Users.goal_ID = Goals.goal_ID
WHERE Goals.goal_type = 'Lose Weight';

-- Q6. Trigger to prevent end time earlier than start time

DELIMITER //

CREATE TRIGGER Check_Workout_Time
BEFORE INSERT ON Workouts
FOR EACH ROW
BEGIN
    IF NEW.end_time < NEW.start_time THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'End time cannot be earlier than start time';
    END IF;
END //

DELIMITER ;

