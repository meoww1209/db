DELIMITER //

CREATE TRIGGER Default_Doctor_Department
BEFORE INSERT ON Doctors
FOR EACH ROW
BEGIN
    IF NEW.DepartmentID IS NULL THEN
        SET NEW.DepartmentID = 1;
    END IF;
END //

DELIMITER ;

-- Q7
DELIMITER //

CREATE TRIGGER Prevent_Past_Appointment
BEFORE INSERT ON Appointments
FOR EACH ROW
BEGIN
    IF NEW.Appointment_Date < CURDATE() THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Past appointments are not allowed';
    END IF;
END //

DELIMITER ;
