DELIMITER //

CREATE PROCEDURE AddPatient(
    IN pid INT,
    IN pname VARCHAR(50),
    IN dob DATE,
    IN paddress VARCHAR(100),
    IN phone VARCHAR(15)
)
BEGIN
    INSERT INTO Patients
    VALUES (pid, pname, dob, paddress, phone);
END //

