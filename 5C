-- Q1
SELECT PatientID, PatientName,
TIMESTAMPDIFF(YEAR, DOB, CURDATE()) AS Age
FROM Patients
WHERE TIMESTAMPDIFF(YEAR, DOB, CURDATE()) > 65;

-- Q2
SELECT AVG(TIMESTAMPDIFF(YEAR, DOB, CURDATE())) AS Average_Age
FROM Patients;

-- Q3
SELECT Doctors.DoctorName, Departments.DepartmentName
FROM Doctors
JOIN Departments
ON Doctors.DepartmentID = Departments.DepartmentID;

