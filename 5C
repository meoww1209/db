-- Q6
DELIMITER //

CREATE PROCEDURE DisplaySeniorPatients()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE pname VARCHAR(50);
    DECLARE phone VARCHAR(15);

    DECLARE patient_cursor CURSOR FOR
        SELECT PatientName, PhoneNumber
        FROM Patients
        WHERE TIMESTAMPDIFF(YEAR, DOB, CURDATE()) > 60;

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET finished = 1;

    OPEN patient_cursor;

    read_loop: LOOP
        FETCH patient_cursor INTO pname, phone;

        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;

        SELECT pname AS Patient_Name, phone AS Phone_Number;
    END LOOP;

    CLOSE patient_cursor;
END //

DELIMITER ;

CALL DisplaySeniorPatients();

