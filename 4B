DELIMITER //

CREATE FUNCTION GetCategoryName(cid INT)
RETURNS VARCHAR(50)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE cname VARCHAR(50);

    SELECT category_name
    INTO cname
    FROM Categories
    WHERE category_ID = cid;

    RETURN cname;
END //

DELIMITER ;

SELECT GetCategoryName(1) AS Category_Name;
