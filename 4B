-- Q1
SELECT Products.name,
COALESCE(SUM(Inventory.quantity_in_stock), 0) AS Total_Stock
FROM Products
LEFT JOIN Inventory
ON Products.product_ID = Inventory.product_ID
GROUP BY Products.product_ID, Products.name;

-- Q2
SELECT Categories.category_name,
AVG(Products.price) AS Average_Price
FROM Categories
JOIN Products
ON Categories.category_ID = Products.category_ID
GROUP BY Categories.category_ID, Categories.category_name;

-- Q3
SELECT Products.name, Products.price
FROM Products
JOIN Categories
ON Products.category_ID = Categories.category_ID
WHERE Categories.category_name = 'Refrigerators'

UNION

SELECT name, price
FROM Products
WHERE price > 1000;

-- Q4
DELIMITER //

CREATE PROCEDURE DisplayProductStock()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE pname VARCHAR(50);
    DECLARE total INT;

    DECLARE product_cursor CURSOR FOR
        SELECT Products.name,
        COALESCE(SUM(Inventory.quantity_in_stock), 0)
        FROM Products
        LEFT JOIN Inventory
        ON Products.product_ID = Inventory.product_ID
        GROUP BY Products.product_ID, Products.name;

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET finished = 1;

    OPEN product_cursor;

    read_loop: LOOP
        FETCH product_cursor INTO pname, total;

        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;

        SELECT pname AS Product_Name, total AS Total_Stock;
    END LOOP;

    CLOSE product_cursor;
END //

DELIMITER ;

CALL DisplayProductStock();

-- Q5
SELECT Warehouses.warehouse_name,
SUM(Inventory.quantity_in_stock) AS Total_Stock
FROM Warehouses
JOIN Inventory
ON Warehouses.warehouse_ID = Inventory.warehouse_ID
GROUP BY Warehouses.warehouse_ID, Warehouses.warehouse_name
HAVING SUM(Inventory.quantity_in_stock) < 50;

