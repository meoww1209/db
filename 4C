DELIMITER //

CREATE TRIGGER Backup_Deleted_Product
AFTER DELETE ON Products
FOR EACH ROW
BEGIN
    INSERT INTO Products_Backup
    (product_ID, name, description, price, category_ID)
    VALUES
    (OLD.product_ID, OLD.name, OLD.description,
     OLD.price, OLD.category_ID);
END //

DELIMITER ;

-- Q4
CREATE VIEW Product_Stock AS
SELECT Products.name,
COALESCE(SUM(Inventory.quantity_in_stock), 0) AS Current_Stock,
Warehouses.warehouse_name
FROM Products
LEFT JOIN Inventory
ON Products.product_ID = Inventory.product_ID
LEFT JOIN Warehouses
ON Inventory.warehouse_ID = Warehouses.warehouse_ID
GROUP BY Products.product_ID, Products.name,
Warehouses.warehouse_ID, Warehouses.warehouse_name;

SELECT * FROM Product_Stock;

