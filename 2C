-- Q1
SELECT Users.name, SUM(Steps.step_count) AS Total_Steps
FROM Users
JOIN Steps ON Users.user_ID = Steps.user_ID
GROUP BY Users.user_ID, Users.name
ORDER BY Total_Steps DESC
LIMIT 1;

-- Q2
SELECT Users.name, Goals.goal_type
FROM Users
JOIN Goals ON Users.goal_ID = Goals.goal_ID
WHERE Goals.goal_type = 'Lose Weight';

-- Q3
SELECT workout_type, AVG(duration_in_minutes) AS Average_Duration
FROM Workouts
GROUP BY workout_type;

-- Q4
DELIMITER //

CREATE FUNCTION TotalSteps(
    uid INT,
    start_date DATE,
    end_date DATE
)
RETURNS INT
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE total INT;

    SELECT COALESCE(SUM(step_count), 0)
    INTO total
    FROM Steps
    WHERE user_ID = uid
    AND tracking_date BETWEEN start_date AND end_date;

    RETURN total;
END //

DELIMITER ;

