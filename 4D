-- Q1
DELIMITER //

CREATE FUNCTION IsOutOfStock(pid INT)
RETURNS BOOLEAN
READS SQL DATA
BEGIN
    DECLARE total_stock INT;

    SELECT COALESCE(SUM(quantity_in_stock), 0)
    INTO total_stock
    FROM Inventory
    WHERE product_ID = pid;

    RETURN total_stock = 0;
END //

DELIMITER ;

SELECT product_ID, name, IsOutOfStock(product_ID) AS Out_Of_Stock
FROM Products;

-- Q2
SELECT Orders.order_ID, Orders.customer_ID,
Orders.order_date, Orders.shipping_address,
Orders.order_status, Shipments.tracking_number
FROM Orders
LEFT JOIN Shipments
ON Orders.order_ID = Shipments.order_ID;

-- Q3
SELECT name, price
FROM Products
WHERE category_ID = (
    SELECT category_ID
    FROM Categories
    WHERE category_name = 'Washing Machines'
)
UNION
SELECT name, price
FROM Products
WHERE price > 900;

-- Q4
SELECT Products.*
FROM Products
JOIN Categories
ON Products.category_ID = Categories.category_ID
WHERE Categories.category_name = 'Refrigerators';

-- Q5
SELECT COUNT(*) AS Total_Orders
FROM Orders;

-- Q6
DELIMITER //

CREATE PROCEDURE DisplayProducts()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE pname VARCHAR(50);
    DECLARE pprice DECIMAL(10,2);

    DECLARE product_cursor CURSOR FOR
        SELECT name, price FROM Products;

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET finished = 1;

    OPEN product_cursor;

    read_loop: LOOP
        FETCH product_cursor INTO pname, pprice;

        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;

        SELECT pname AS Product_Name, pprice AS Price;
    END LOOP;

    CLOSE product_cursor;
END //

DELIMITER ;

CALL DisplayProducts();

