-- Q4
DELIMITER //

CREATE PROCEDURE PatientCountByAgeGroup()
BEGIN
    SELECT
        CASE
            WHEN TIMESTAMPDIFF(YEAR, DOB, CURDATE()) < 18
                THEN 'Below 18'
            WHEN TIMESTAMPDIFF(YEAR, DOB, CURDATE()) BETWEEN 18 AND 60
                THEN '18 to 60'
            ELSE 'Above 60'
        END AS Age_Group,
        COUNT(*) AS Total_Patients
    FROM Patients
    GROUP BY Age_Group;
END //

DELIMITER ;

CALL PatientCountByAgeGroup();

