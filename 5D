-- Q6
DELIMITER //

CREATE FUNCTION CountAppointments(pid INT)
RETURNS INT
READS SQL DATA
BEGIN
    DECLARE total INT;

    SELECT COUNT(*)
    INTO total
    FROM Appointments
    WHERE PatientID = pid;

    RETURN total;
END //

DELIMITER ;

SELECT PatientID, PatientName,
CountAppointments(PatientID) AS Total_Appointments
FROM Patients;

-- Q7
DELIMITER //

CREATE TRIGGER Check_Patient_Phone
BEFORE INSERT ON Patients
FOR EACH ROW
BEGIN
    IF NEW.PhoneNumber IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Phone number cannot be NULL';
    END IF;
END //

DELIMITER ;
