-- Q2
SELECT Departments.DepartmentName,
COUNT(Doctors.DoctorID) AS Total_Doctors
FROM Departments
LEFT JOIN Doctors
ON Departments.DepartmentID = Doctors.DepartmentID
GROUP BY Departments.DepartmentID, Departments.DepartmentName;

-- Q3
SELECT Doctors.DoctorName,
COUNT(Appointments.AppointmentID) AS Total_Appointments
FROM Doctors
LEFT JOIN Appointments
ON Doctors.DoctorID = Appointments.DoctorID
GROUP BY Doctors.DoctorID, Doctors.DoctorName;

-- Q4
CREATE VIEW Patient_Appointments AS
SELECT Patients.PatientName,
Appointments.Appointment_Date
FROM Patients
JOIN Appointments
ON Patients.PatientID = Appointments.PatientID;

SELECT * FROM Patient_Appointments;

-- Q5
DELIMITER //

CREATE TRIGGER Prevent_Duplicate_Appointment
BEFORE INSERT ON Appointments
FOR EACH ROW
BEGIN
    IF EXISTS (
        SELECT 1
        FROM Appointments
        WHERE PatientID = NEW.PatientID
        AND DoctorID = NEW.DoctorID
        AND Appointment_Date = NEW.Appointment_Date
        AND Created_At_time = NEW.Created_At_time
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Duplicate appointment not allowed';
    END IF;
END //

DELIMITER ;

