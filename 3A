-- Q2
DELIMITER //

CREATE PROCEDURE OrderDetails(IN oid INT)
BEGIN
    SELECT Orders.order_ID, Customers.name,
    Menu.item_name, OrderItems.quantity,
    OrderItems.unit_price
    FROM Orders
    JOIN Customers ON Orders.customer_ID = Customers.customer_ID
    JOIN OrderItems ON Orders.order_ID = OrderItems.order_ID
    JOIN Menu ON OrderItems.item_ID = Menu.item_ID
    WHERE Orders.order_ID = oid;
END //

DELIMITER ;

CALL OrderDetails(1);

