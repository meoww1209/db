-- Q4
SELECT Menu.item_ID, Menu.item_name
FROM Menu
LEFT JOIN OrderItems ON Menu.item_ID = OrderItems.item_ID
WHERE OrderItems.item_ID IS NULL;

-- Q5
CREATE VIEW Top_3_Selling_Items AS
SELECT Menu.item_name,
SUM(OrderItems.quantity) AS Total_Sold
FROM Menu
JOIN OrderItems ON Menu.item_ID = OrderItems.item_ID
GROUP BY Menu.item_ID, Menu.item_name
ORDER BY Total_Sold DESC
LIMIT 3;

SELECT * FROM Top_3_Selling_Items;

