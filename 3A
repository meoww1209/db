-- Q7
DELIMITER //

CREATE PROCEDURE DailySales()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE sale_date DATE;
    DECLARE total DECIMAL(10,2);

    DECLARE sales_cursor CURSOR FOR
        SELECT DATE(Orders.order_date_time),
        SUM(OrderItems.quantity * OrderItems.unit_price)
        FROM Orders
        JOIN OrderItems ON Orders.order_ID = OrderItems.order_ID
        GROUP BY DATE(Orders.order_date_time);

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET finished = 1;

    OPEN sales_cursor;

    read_loop: LOOP
        FETCH sales_cursor INTO sale_date, total;

        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;

        SELECT sale_date AS Sale_Date, total AS Total_Sales;
    END LOOP;

    CLOSE sales_cursor;
END //

DELIMITER ;

CALL DailySales();
