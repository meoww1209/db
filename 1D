-- Q1
SELECT Students.name, Classes.class_name
FROM Students
JOIN Classes ON Students.class_ID = Classes.class_ID;

-- Q2
SELECT Subjects.subject_name, MAX(Grades.marks) AS Highest_Marks
FROM Subjects
JOIN Grades ON Subjects.subject_ID = Grades.subject_ID
GROUP BY Subjects.subject_ID, Subjects.subject_name;

-- Q3
DELIMITER //

CREATE TRIGGER Prevent_Negative_Marks
BEFORE INSERT ON Grades
FOR EACH ROW
BEGIN
    IF NEW.marks < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Marks cannot be negative';
    END IF;
END //

DELIMITER ;

-- Q4
DELIMITER //

CREATE PROCEDURE TotalStudents(IN cid INT)
BEGIN
    SELECT COUNT(*) AS Total_Students
    FROM Students
    WHERE class_ID = cid;
END //

DELIMITER ;

CALL TotalStudents(1);

-- Q5
SELECT Students.student_ID, Students.name, SUM(Grades.marks) AS Total_Marks
FROM Students
JOIN Grades ON Students.student_ID = Grades.student_ID
GROUP BY Students.student_ID, Students.name
HAVING SUM(Grades.marks) > 80;

