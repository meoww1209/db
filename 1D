-- Q7
SELECT Subjects.subject_name, AVG(Grades.marks) AS Subject_Average
FROM Subjects
JOIN Grades ON Subjects.subject_ID = Grades.subject_ID
GROUP BY Subjects.subject_ID, Subjects.subject_name
HAVING AVG(Grades.marks) > (
    SELECT AVG(marks)
    FROM Grades
);
