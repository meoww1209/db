-- Q4
SELECT AVG((No_Of_Days_Present / Total_Days) * 100) AS Average_Attendance
FROM Attendance
JOIN Students ON Attendance.student_ID = Students.student_ID
JOIN Classes ON Students.class_ID = Classes.class_ID
WHERE Classes.class_name = 'SE' AND Attendance.Month = 3;

-- Q5
SELECT DISTINCT Students.name
FROM Students
JOIN Marks ON Students.student_ID = Marks.student_ID
WHERE Marks.marks < 10;

-- Q6
SELECT Students.name, SUM(Marks.marks) AS Total_Marks
FROM Students
JOIN Classes ON Students.class_ID = Classes.class_ID
JOIN Marks ON Students.student_ID = Marks.student_ID
WHERE Classes.class_name = 'SE' AND Marks.exam_name = 'Midterm'
GROUP BY Students.student_ID, Students.name;

-- Q7
DELIMITER //

CREATE PROCEDURE DisplayStudents()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE student_name VARCHAR(50);

    DECLARE student_cursor CURSOR FOR
        SELECT name FROM Students;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    OPEN student_cursor;

    read_loop: LOOP
        FETCH student_cursor INTO student_name;

        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;

        SELECT student_name AS Student_Name;
    END LOOP;

    CLOSE student_cursor;
END //

DELIMITER ;

CALL DisplayStudents();
