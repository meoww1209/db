-- Q1
DELIMITER //

CREATE FUNCTION AbsentDays(sid INT, m INT, y INT)
RETURNS INT
READS SQL DATA
BEGIN
    DECLARE absent INT DEFAULT 0;

    SELECT COALESCE(MAX(Total_Days - No_Of_Days_Present), 0)
    INTO absent
    FROM Attendance
    WHERE student_ID = sid AND Month = m AND Year = y;

    RETURN absent;
END //

DELIMITER ;

SELECT AbsentDays(101, 3, 2026);

-- Q2
SELECT DISTINCT Students.name
FROM Students
JOIN Marks ON Students.student_ID = Marks.student_ID
JOIN Classes ON Students.class_ID = Classes.class_ID
WHERE Classes.class_name = 'SE' AND Marks.marks > 20;

