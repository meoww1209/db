DELIMITER //

CREATE TRIGGER Backup_Customer
AFTER DELETE ON Customers
FOR EACH ROW
BEGIN
    INSERT INTO Customer_Backup
    (customer_ID, name, contact_number, deleted_at)
    VALUES
    (OLD.customer_ID, OLD.name, OLD.contact_number, NOW());
END //

DELIMITER ;

-- Q4
DELIMITER //

CREATE PROCEDURE AddMenuItem(
    IN itemName VARCHAR(50),
    IN itemCategory VARCHAR(50),
    IN itemPrice DECIMAL(10,2)
)
BEGIN
    INSERT INTO Menu (item_name, category, price)
    VALUES (itemName, itemCategory, itemPrice);
END //

DELIMITER ;

