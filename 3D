-- Q5
SELECT Menu.item_name,
COALESCE(SUM(OrderItems.quantity), 0) AS Total_Quantity_Sold
FROM Menu
LEFT JOIN OrderItems ON Menu.item_ID = OrderItems.item_ID
GROUP BY Menu.item_ID, Menu.item_name;

-- Q6
SELECT Customers.customer_ID, Customers.name,
SUM(OrderItems.quantity * OrderItems.unit_price) AS Total_Amount
FROM Customers
JOIN Orders ON Customers.customer_ID = Orders.customer_ID
JOIN OrderItems ON Orders.order_ID = OrderItems.order_ID
GROUP BY Customers.customer_ID, Customers.name
HAVING SUM(OrderItems.quantity * OrderItems.unit_price) > 1000;

