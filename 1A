-- Q1. CREATE A VIEW TO GET STUDENT MARKS FOR ALL SUBJECTS

CREATE VIEW Student_Marks AS
SELECT Students.student_ID, Students.name,
Subjects.subject_name, Marks.marks
FROM Students
JOIN Marks ON Students.student_ID = Marks.student_ID
JOIN Subjects ON Marks.subject_ID = Subjects.subject_ID;

SELECT * FROM Student_Marks;

-- Q2. PROCEDURE TO GET AVERAGE MARKS OF A SPECIFIC CLASS

DELIMITER //

CREATE PROCEDURE AvgMarks(IN cid INT)
BEGIN
    SELECT AVG(marks) AS Average_Marks
    FROM Marks
    WHERE class_ID = cid;
END //

DELIMITER ;

CALL AvgMarks(1);

-- Q3. STUDENT WITH HIGHEST MARKS IN A GIVEN SUBJECT
-- Subject ID 1 = DBMS

SELECT Students.student_ID, Students.name,
Classes.class_name, Marks.marks
FROM Students
JOIN Classes ON Students.class_ID = Classes.class_ID
JOIN Marks ON Students.student_ID = Marks.student_ID
WHERE Marks.subject_ID = 1
AND Marks.marks = (
    SELECT MAX(marks)
    FROM Marks
    WHERE subject_ID = 1
);

-- Q4. STUDENTS BORN IN MARCH

SELECT name, date_of_birth
FROM Students
WHERE MONTH(date_of_birth) = 3;

-- Q5. AVERAGE MARKS FOR EACH SUBJECT IN A SPECIFIC EXAM

SELECT Subjects.subject_name, AVG(Marks.marks) AS Average_Marks
FROM Marks
JOIN Subjects ON Marks.subject_ID = Subjects.subject_ID
WHERE Marks.exam_name = 'Midterm'
GROUP BY Subjects.subject_ID, Subjects.subject_name;

-- Q6. TOTAL NUMBER OF STUDENTS IN EACH CLASS

SELECT Classes.class_name,
COUNT(Students.student_ID) AS Total_Students
FROM Classes
LEFT JOIN Students ON Classes.class_ID = Students.class_ID
GROUP BY Classes.class_ID, Classes.class_name;

