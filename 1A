-- Q1
CREATE VIEW Student_Marks AS
SELECT Students.student_ID, Students.name, Classes.class_name,
       Subjects.subject_name, Marks.exam_name, Marks.marks
FROM Students
JOIN Classes ON Students.class_ID = Classes.class_ID
JOIN Marks ON Students.student_ID = Marks.student_ID
JOIN Subjects ON Marks.subject_ID = Subjects.subject_ID;

SELECT * FROM Student_Marks;

-- Q2
DELIMITER //

CREATE PROCEDURE AvgMarks(IN cid INT)
BEGIN
    SELECT AVG(marks) AS Average_Marks
    FROM Marks
    WHERE class_ID = cid;
END //

DELIMITER ;

CALL AvgMarks(1);

-- Q3
SELECT Students.student_ID, Students.name, Classes.class_name, Marks.marks
FROM Marks
JOIN Students ON Marks.student_ID = Students.student_ID
JOIN Classes ON Marks.class_ID = Classes.class_ID
WHERE Marks.subject_ID = 1
ORDER BY Marks.marks DESC
LIMIT 1;

