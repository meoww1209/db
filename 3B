-- Q1
SELECT item_ID, item_name,
(quantity * unit_price) AS Total_Price
FROM OrderItems
JOIN Menu USING (item_ID)
WHERE order_ID = 1;

-- Q2
SELECT DISTINCT Customers.*
FROM Customers
JOIN Orders ON Customers.customer_ID = Orders.customer_ID;

-- Q3
SELECT COUNT(*) AS Total_Customers
FROM Customers;

-- Q4
SELECT Customers.customer_ID, Customers.name
FROM Customers
JOIN Orders ON Customers.customer_ID = Orders.customer_ID
JOIN OrderItems ON Orders.order_ID = OrderItems.order_ID
JOIN Menu ON OrderItems.item_ID = Menu.item_ID
WHERE Menu.category IN ('Pizza', 'Burger')
GROUP BY Customers.customer_ID, Customers.name
HAVING COUNT(DISTINCT Menu.category) = 2;

-- Q5
SELECT Menu.item_ID, Menu.item_name
FROM Menu
LEFT JOIN OrderItems ON Menu.item_ID = OrderItems.item_ID
WHERE OrderItems.item_ID IS NULL;

-- Q6
DELIMITER //

CREATE FUNCTION CheckCategory(
    iid INT,
    cat VARCHAR(50)
)
RETURNS BOOLEAN
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE result INT;

    SELECT COUNT(*)
    INTO result
    FROM Menu
    WHERE item_ID = iid
    AND category = cat;

    RETURN result > 0;
END //

DELIMITER ;

SELECT CheckCategory(1, 'Pizza') AS Category_Check;

