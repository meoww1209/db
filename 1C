-- Q5
DELIMITER //

CREATE TRIGGER Class_Change
AFTER UPDATE ON Students
FOR EACH ROW
BEGIN
    IF OLD.class_ID <> NEW.class_ID THEN
        INSERT INTO Student_Class_History
        (student_name, old_class_ID, new_class_ID)
        VALUES
        (NEW.name, OLD.class_ID, NEW.class_ID);
    END IF;
END //

DELIMITER ;

