CREATE PROCEDURE AddWorkout(
    IN wid INT,
    IN uid INT,
    IN wdate DATE,
    IN wtype VARCHAR(50),
    IN st TIME,
    IN et TIME,
    IN duration INT
)
BEGIN
    INSERT INTO Workouts
    VALUES (wid, uid, wdate, wtype, st, et, duration);
END //

