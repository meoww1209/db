DELIMITER //

CREATE PROCEDURE DisplayUsers()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE uname VARCHAR(50);

    DECLARE user_cursor CURSOR FOR
        SELECT name FROM Users;

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET finished = 1;

    OPEN user_cursor;

    read_loop: LOOP
        FETCH user_cursor INTO uname;

        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;

        SELECT uname AS User_Name;
    END LOOP;

    CLOSE user_cursor;
END //

DELIMITER ;

CALL DisplayUsers();

