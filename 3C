-- Q1
DELIMITER //

CREATE PROCEDURE AddMenuItem(
    IN itemName VARCHAR(50),
    IN itemCategory VARCHAR(50),
    IN itemPrice DECIMAL(10,2)
)
BEGIN
    INSERT INTO Menu (item_name, category, price)
    VALUES (itemName, itemCategory, itemPrice);
END //

DELIMITER ;

CALL AddMenuItem('Paneer Pizza', 'Pizza', 280);

-- Q2
SELECT item_name, price
FROM Menu
WHERE price = (SELECT MAX(price) FROM Menu);

SELECT item_name, price
FROM Menu
WHERE price = (SELECT MIN(price) FROM Menu);

-- Q3
SELECT category, COUNT(*) AS Total_Items
FROM Menu
GROUP BY category;

-- Q4
SELECT AVG(Total_Items) AS Average_Items_Per_Order
FROM (
    SELECT order_ID, SUM(quantity) AS Total_Items
    FROM OrderItems
    GROUP BY order_ID
) AS Order_Summary;

-- Q5
SELECT Menu.item_name
FROM Menu
JOIN OrderItems ON Menu.item_ID = OrderItems.item_ID
WHERE OrderItems.order_ID = 1;

-- Q6
SELECT Customers.customer_ID, Customers.name,
COUNT(Orders.order_ID) AS Total_Orders
FROM Customers
JOIN Orders ON Customers.customer_ID = Orders.customer_ID
GROUP BY Customers.customer_ID, Customers.name
HAVING COUNT(Orders.order_ID) > 3;

-- Q7
SELECT Menu.item_name, AVG(OrderItems.unit_price) AS Average_Unit_Price
FROM Menu
JOIN OrderItems ON Menu.item_ID = OrderItems.item_ID
GROUP BY Menu.item_ID, Menu.item_name
HAVING AVG(OrderItems.unit_price) > 200;
